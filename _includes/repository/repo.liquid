{% assign repo_url = include.repository | split: '/' %}
{% assign stats = site.data.github_stats.repos[include.repository] %}

<div class="repo p-2">
  <div class="card h-100">
    <div class="card-body text-start">
      <h5 class="card-title repo-card-title">
        <a href="https://github.com/{{ include.repository }}"><i class="fa-brands fa-github"></i> {{ repo_url[1] }}</a>
      </h5>
      {% if stats %}
        <p class="card-text repo-card-desc">{{ stats.description | default: 'No description provided.' }}</p>
        <div class="repo-card-meta">
          {% if stats.language %}
            <span class="repo-lang">
              <span class="lang-dot" style="background-color: {{ site.data.github_colors[stats.language] | default: '#8f8f8f' }};"></span>
              {{ stats.language }}
            </span>
          {% endif %}
          <span title="Stars"><i class="fa-solid fa-star"></i> {{ stats.stargazers_count }}</span>
          <span title="Forks"><i class="fa-solid fa-code-fork"></i> {{ stats.forks_count }}</span>
          {% if stats.license %}
            <span title="License"><i class="fa-solid fa-scale-balanced"></i> {{ stats.license }}</span>
          {% endif %}
        </div>
      {% else %}
        <p class="card-text repo-fallback-text">GitHub stats unavailable right now.</p>
      {% endif %}
    </div>
  </div>
</div>
