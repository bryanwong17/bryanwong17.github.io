{% assign stats = site.data.github_stats.users[include.username] %}

<div class="repo p-2">
  <div class="card h-100">
    <div class="card-body text-start">
      {% if stats %}
        <div class="repo-user-header">
          <img class="repo-avatar" src="{{ stats.avatar_url }}" alt="{{ stats.login }}">
          <div>
            <a href="{{ stats.html_url }}" class="card-title repo-card-title">{{ stats.name | default: stats.login }}</a>
            <div class="repo-user-handle">@{{ stats.login }}</div>
          </div>
        </div>
        <div class="repo-stats-grid">
          <div>
            <span class="stat-value">{{ stats.public_repos }}</span>
            <span class="stat-label">Repos</span>
          </div>
          <div>
            <span class="stat-value">{{ stats.followers }}</span>
            <span class="stat-label">Followers</span>
          </div>
          <div>
            <span class="stat-value">{{ stats.total_stars }}</span>
            <span class="stat-label">Total Stars</span>
          </div>
        </div>
      {% else %}
        <p class="card-text repo-fallback-text">{{ include.username }} — GitHub stats unavailable right now.</p>
      {% endif %}
    </div>
  </div>
</div>
